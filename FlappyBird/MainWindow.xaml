<Window x:Class="FlappyBird.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlappyBird"
        mc:Ignorable="d"
        Title="FlappyBird" Height="600" Width="900"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="start" Content="Start" Width="90" Height="40" Click="start_Click" Grid.Column="0" FontSize="18"/>
            <TextBlock x:Name="score" Text="Score: 0" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" FontWeight="Bold"/>
            <CheckBox x:Name="Mbackground" Content="Moving background" IsChecked="True" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="2" FontSize="15"/>
        </Grid>

        <Canvas x:Name="map" Background="SkyBlue" Grid.Row="1">
            <Image x:Name="birdImage" Width="45" Height="40" Canvas.Left="150" Canvas.Top="150"/>
            <TextBlock x:Name="txtGameOver" Text="Game over" FontSize="45" FontWeight="Bold" Foreground="Red" Visibility="Collapsed" Canvas.Left="280" Canvas.Top="180"/>
        </Canvas>
    </Grid>
</Window>
