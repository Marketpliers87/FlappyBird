<Window x:Class="FlappyBird.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlappyBird"
        mc:Ignorable="d"
        Title="FlappyBird" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Button x:Name="start" Content="Start" Width="90" Height="45" Grid.Row="0" Click="start_Click" />
        <Canvas x:Name="palya" Background="AliceBlue" Grid.Row="3">
            <Button x:Name="auto2" Content="Birb" Width="50" Height="40" Background="Green"
                    Canvas.Left="20" Canvas.Top="140"/>
        </Canvas>
    </Grid>
</Window>
